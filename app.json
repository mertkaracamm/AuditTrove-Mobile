{
  "expo": {
    "name": "AuditTrove",
    "slug": "audittrove",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050F33"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.audittrove.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Belgelerinizi tarayıp incelemek için kamera erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Belgelerinizin fotoğraflarını seçip incelemek için fotoğraflarınıza erişim gerekir."
      }
    },
    "android": {
      "package": "com.audittrove.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050F33"
      }
    },
    "extra": {
      "eas": {
        "projectId": "e2f4d238-9372-45dd-abe7-60a14e828095"
      }
    },
    "owner": "mertkaracam",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      "expo-localization",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Belgelerinizi tarayıp incelemek için kamera erişimi gerekir."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Belgelerinizin fotoğraflarını seçip incelemek için fotoğraflarınıza erişim gerekir."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#05D9F0"
        }
      ]
    ]
  }
}
